# ============================================================================
# RUNTIME STUDIO DEVS — PLANTILLA DE VARIABLES DE ENTORNO (VERCEL & LOCAL)
# ============================================================================
# Copia este archivo como `.env.local` para pruebas locales con secretos,
# o configura estas variables en Vercel Dashboard -> Settings -> Environment Variables.

# ----------------------------------------------------------------------------
# 1. IDENTIDAD Y ENTORNO (Production vs Preview / Development)
# ----------------------------------------------------------------------------
# Valores para Production (rama `main`):
#   NEXT_PUBLIC_APP_ENV=production
#   NEXT_PUBLIC_SITE_TITLE="Runtime Studio Devs | Colectivo de Ingeniería y Desarrollo de Software"
#   NEXT_PUBLIC_SITE_URL=https://runtimestudiodevs.com
#
# Valores para Preview / Development (rama `develop` y PRs):
#   NEXT_PUBLIC_APP_ENV=develop
#   NEXT_PUBLIC_SITE_TITLE=Develop
#   NEXT_PUBLIC_SITE_URL=https://dev.runtimestudiodevs.com
NEXT_PUBLIC_APP_ENV=develop
NEXT_PUBLIC_SITE_TITLE=Develop
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# 2. CANALES DE CONTACTO & NOTIFICACIONES
# ----------------------------------------------------------------------------
# Número de WhatsApp en formato internacional sin '+' ni espacios (ej. 573194312060)
NEXT_PUBLIC_WHATSAPP_PHONE=

# URL del Webhook de Discord para recibir leads desde POST /api/contact (Server-only)
DISCORD_WEBHOOK_URL=
